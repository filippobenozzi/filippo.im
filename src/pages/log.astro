---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDateShort } from '../lib/date';

const entries = (await getCollection('log')).sort((a, b) => (a.data.date < b.data.date ? 1 : -1));

const posts = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return {
      Content,
      date: entry.data.date,
      dateLabel: formatDateShort(entry.data.date),
      title: entry.data.title,
    };
  })
);
---

<BaseLayout
  title="log"
  description="A running log of notes, links and pills — synced from my Obsidian vault."
  canonicalPath="/log"
>
  <section>
    <h1 class="font-bold text-2xl mb-8">my log</h1>
    <div class="prose prose-neutral mb-12 dark:prose-invert">
      <p>
        This is my personal log, synced from Obsidian — short notes, links and pills I want to
        remember.
      </p>
    </div>

    {
      posts.length === 0 ? (
        <p class="text-sm text-neutral-400 dark:text-neutral-400">Nothing here yet.</p>
      ) : (
        <div class="flex flex-col">
          {posts.map(({ Content, date, dateLabel, title }) => (
            <article id={date} class="log-entry relative mb-14 scroll-mt-24 lg:mb-20">
              <header class="mb-2 lg:mb-0 lg:absolute lg:right-full lg:mr-6 lg:w-32 lg:pt-1 lg:text-right">
                <a
                  href={`#${date}`}
                  class="block text-sm text-neutral-400 transition-colors hover:text-neutral-700 dark:text-neutral-500 dark:hover:text-neutral-300"
                >
                  {title ? (
                    <>
                      <span class="block font-medium text-neutral-500 dark:text-neutral-300">
                        {title}
                      </span>
                      <time datetime={date} class="mt-0.5 block whitespace-nowrap text-xs opacity-80">
                        {dateLabel}
                      </time>
                    </>
                  ) : (
                    <time datetime={date} class="whitespace-nowrap">
                      {dateLabel}
                    </time>
                  )}
                </a>
              </header>
              <div class="prose prose-quoteless prose-neutral dark:prose-invert">
                <Content />
              </div>
            </article>
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
