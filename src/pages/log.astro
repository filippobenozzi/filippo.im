---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDateShort } from '../lib/date';

const entries = (await getCollection('log')).sort((a, b) => (a.data.date < b.data.date ? 1 : -1));

const posts = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return {
      Content,
      date: entry.data.date,
      dateLabel: formatDateShort(entry.data.date),
      title: entry.data.title,
      location: entry.data.location,
    };
  })
);
---

<BaseLayout
  title="log"
  description="A running log of notes, links and pills — synced from my Obsidian vault."
  canonicalPath="/log"
>
  <section>
    <h1 class="font-bold text-2xl mb-8">my log</h1>
    <div class="prose prose-neutral mb-12 dark:prose-invert">
      <p>
        This is my personal log, synced from Obsidian — short notes, links and pills I want to
        remember.
      </p>
    </div>

    {
      posts.length === 0 ? (
        <p class="text-sm text-neutral-400 dark:text-neutral-400">Nothing here yet.</p>
      ) : (
        <div class="flex flex-col">
          {posts.map(({ Content, date, dateLabel, title, location }) => (
            <article id={date} class="log-entry relative mb-14 scroll-mt-24 lg:mb-24">
              {/* Desktop: the gutter spans the whole post and the label sticks
                  to the top while its body scrolls past. Mobile: plain in-flow. */}
              <div class="mb-2 lg:absolute lg:inset-y-0 lg:right-full lg:mb-0 lg:mr-6 lg:w-32 lg:text-right">
                <div class="lg:sticky lg:top-24 lg:pt-1">
                  <a
                    href={`#${date}`}
                    class="block text-sm text-neutral-400 transition-colors hover:text-neutral-700 dark:text-neutral-500 dark:hover:text-neutral-300"
                  >
                    {title && (
                      <span class="block font-medium text-neutral-500 dark:text-neutral-300">
                        {title}
                      </span>
                    )}
                    <time datetime={date} class="block whitespace-nowrap">
                      {dateLabel}
                    </time>
                    {location && (
                      <span class="mt-0.5 block text-neutral-400/70 dark:text-neutral-500/70">
                        {location}
                      </span>
                    )}
                  </a>
                </div>
              </div>
              <div class="prose prose-quoteless prose-neutral dark:prose-invert">
                <Content />
              </div>
            </article>
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
