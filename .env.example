PUBLIC_UMAMI_HOST=
PUBLIC_UMAMI_ID=

# Obsidian LiveSync (CouchDB) — used only at build time by scripts/sync-log.ts.
# These never reach the client: the /log pages are pre-rendered to static HTML.
COUCHDB_URL=https://obsidian.example.com
COUCHDB_DB=obsidian
COUCHDB_USER=obsidian
COUCHDB_PASSWORD=
# Vault folder to publish from. Notes are filed as <folder>/YYYY/MM/YYYY-MM-DD.md
LOG_FOLDER=Log
